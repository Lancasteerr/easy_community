# Vite 服务端使用的开发上传配置；不含存储凭证，不暴露为 VITE_* 浏览器变量。
# 复制为 .env.development.local，修改后重启 Vite。
# 与 backend/.env 的 MEDIA_STORAGE_ENDPOINT、MEDIA_STORAGE_BUCKET 保持一致；目标不含路径或桶名。
# 后端 MEDIA_STORAGE_UPLOAD_ENDPOINT 使用 http://127.0.0.1:5173/__media/upload。
MEDIA_DEV_MINIO_TARGET=http://127.0.0.1:9000
MEDIA_DEV_BUCKET=easy-community-dev
