# 复制为根目录 .env.compose.dev，填写本机密码；真实文件已被 Git 忽略。
# 此文件使用 Docker Compose 语法，不供 Spring 读取。
# 包含 $、# 或引号的值建议使用单引号；两份配置应同步实际值，而非照搬引号。

# MySQL 自动创建 easy_community，开发账号仅拥有该库的权限。
MYSQL_PORT=13306
DB_USERNAME=ec_dev
DB_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password

# Redis 开启密码认证和 AOF 持久化。
REDIS_PORT=16379
REDIS_PASSWORD=replace-with-local-redis-password

# MinIO 凭证也用于本地控制台和一次性桶初始化。
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MEDIA_STORAGE_ACCESS_KEY=replace-with-minio-access-key
MEDIA_STORAGE_SECRET_KEY=replace-with-minio-secret-key
MEDIA_STORAGE_BUCKET=easy-community-dev
MEDIA_KEY_PREFIX=easy-community/dev
MEDIA_FRONTEND_ORIGIN=http://127.0.0.1:5173
MEDIA_WEBHOOK_TOKEN=replace-with-single-segment-webhook-secret
# 宿主机 IDEA 中 Spring 的监听端口，必须与 backend/.env.dev 一致。
SERVER_PORT=8080

# RabbitMQ 默认启动；未来应用连接时使用此账号和 easy_community_dev vhost。
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=ec_dev
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
