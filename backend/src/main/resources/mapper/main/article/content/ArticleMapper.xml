<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.febrie.backend.article.content.infrastructure.persistence.mapper.ArticleMapper">
    <!-- 调用者已持文章行锁；创建路径不递增，直接记录最终v1。 -->
    <update id="advanceMetaVersion">UPDATE article SET meta_version=meta_version+1 WHERE id=#{id}</update>
    <insert id="appendIndexEvent">
        INSERT INTO article_outbox(article_id, meta_version)
        SELECT id, meta_version FROM article WHERE id=#{id}
    </insert>
    <!-- 与文章创建同事务，不依赖点赞功能开关。 -->
    <insert id="initializeLikeCount">INSERT INTO article_like_count(article_id, like_count) VALUES (#{id}, 0)</insert>
    <select id="lock" resultType="com.febrie.backend.article.content.infrastructure.persistence.entity.ArticleEntity">
        SELECT * FROM article WHERE id = #{id} FOR UPDATE
    </select>
    <!-- 列表严格排除大正文，不能用SELECT *后在Java中丢弃。 -->
    <select id="listRows" resultType="com.febrie.backend.article.content.infrastructure.persistence.entity.ArticleEntity">
        SELECT id, author_id, title, summary, cover_media_id, hidden, created_at, updated_at, published_at
        FROM article WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
    </select>
    <select id="tags" resultType="com.febrie.backend.article.content.infrastructure.persistence.entity.ArticleTagRow">
        SELECT r.article_id, t.id AS tag_id, t.name FROM article_tag r JOIN tag t ON t.id = r.tag_id
        WHERE r.article_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
        ORDER BY r.article_id, t.id
    </select>
    <delete id="removeTags">DELETE FROM article_tag WHERE article_id = #{id}</delete>
    <insert id="addTags">
        INSERT INTO article_tag (article_id, tag_id) VALUES
        <foreach collection="tags" item="tag" separator=",">(#{id}, #{tag})</foreach>
    </insert>
    <select id="hiddenIds" resultType="long">
        SELECT id FROM article WHERE hidden = TRUE AND id &gt; #{after} ORDER BY id LIMIT #{size}
    </select>
</mapper>
