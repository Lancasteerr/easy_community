<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.febrie.backend.article.search.infrastructure.persistence.mapper.ArticleIndexMapper">
    <!-- 不读正文，调用方在短RR事务内一起读取Tag。 -->
    <select id="metadata" resultType="com.febrie.backend.article.search.infrastructure.persistence.mapper.ArticleIndexMapper$MetaRow">
        SELECT id AS article_id,title,published_at,hidden,meta_version FROM article WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
    </select>
    <select id="tags" resultType="com.febrie.backend.article.search.infrastructure.persistence.mapper.ArticleIndexMapper$TagRow">
        SELECT article_id,tag_id FROM article_tag WHERE article_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
        ORDER BY article_id,tag_id
    </select>
</mapper>
