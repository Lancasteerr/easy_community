# 复制为服务器上的 .env.prod，并替换全部占位值；真实文件不提交到 Git。
# 文件按 Java Properties 读取：值无需引号，不支持 export 或 shell 变量展开。
# 启动时通过 --spring.profiles.active=prod 或系统环境变量选择生产环境。

# 主机名仅为示例，按实际数据库与专用容器网络填写。
SERVER_PORT=8080
DB_URL=jdbc:mysql://mysql:3306/easy_community?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=easy_community_app
DB_PASSWORD=replace-with-production-db-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-production-redis-password

# 只匹配实际 Nginx 地址；使用 [.] 表示点，避免 Properties 对反斜杠的转义。
TRUSTED_PROXY_REGEX=172[.]31[.]0[.]2
