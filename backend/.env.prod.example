# 复制为服务器上的 .env.prod，并替换全部占位值；真实文件不提交到 Git。
# 文件按 Java Properties 读取：值无需引号，不支持 export 或 shell 变量展开。
# 启动时通过 --spring.profiles.active=prod 或系统环境变量选择生产环境。

# 主机名仅为示例，按实际数据库与专用容器网络填写。
SERVER_PORT=8080
DB_URL=jdbc:mysql://mysql:3306/easy_community?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=easy_community_app
DB_PASSWORD=replace-with-production-db-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-production-redis-password

# 只匹配实际 Nginx 地址；使用 [.] 表示点，避免 Properties 对反斜杠的转义。
TRUSTED_PROXY_REGEX=172[.]31[.]0[.]2

# 生产必须使用COS与真实审核，不能切换为开发MinIO或跳过审核。
MEDIA_STORAGE_PROVIDER=cos
MEDIA_STORAGE_ENDPOINT=https://replace-bucket-1250000000.cos.ap-guangzhou.myqcloud.com
MEDIA_STORAGE_UPLOAD_ENDPOINT=https://replace-bucket-1250000000.cos.ap-guangzhou.myqcloud.com
MEDIA_STORAGE_REGION=ap-guangzhou
MEDIA_STORAGE_BUCKET=replace-bucket-1250000000
MEDIA_STORAGE_ACCESS_KEY=replace-with-cos-secret-id
MEDIA_STORAGE_SECRET_KEY=replace-with-cos-secret-key
MEDIA_KEY_PREFIX=easy-community/prod
MEDIA_PUBLIC_BASE_URL=https://images.example.com
MEDIA_COS_CALLBACK_URL=https://community.example.com/api/storage/cos/upload-callback
MEDIA_COS_CALLBACK_KEY=replace-with-key-agreed-with-cos
MEDIA_MODERATION_BIZ_TYPE=replace-with-real-auditing-biz-type
MEDIA_UPLOADS_PER_MINUTE=30
