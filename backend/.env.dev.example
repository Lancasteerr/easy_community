# 复制为同目录的 .env.dev，填写本机密码；真实文件不提交到 Git。
# 文件按 Java Properties 读取：值无需引号，不支持 export 或 shell 变量展开。
# 启动时在 IDEA 或命令行选择 dev；不要在此文件内设置运行环境。

# 本地服务与数据库连接。
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/easy_community?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=root
DB_PASSWORD=replace-with-local-db-password

# 本机 Redis 未设置密码时保留空值。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 本机MinIO示例；使用专用桶，部署步骤见文件服务文档。
MEDIA_STORAGE_PROVIDER=minio
MEDIA_STORAGE_ENDPOINT=http://127.0.0.1:9000
MEDIA_STORAGE_UPLOAD_ENDPOINT=http://127.0.0.1:9000
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_BUCKET=easy-community-dev
MEDIA_STORAGE_ACCESS_KEY=replace-with-minio-access-key
MEDIA_STORAGE_SECRET_KEY=replace-with-minio-secret-key
MEDIA_KEY_PREFIX=easy-community/dev
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/easy-community-dev
