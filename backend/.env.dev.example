# 复制为同目录的 .env.dev，与根目录 .env.compose.dev 同步本机密码；真实文件不提交到 Git。
# 文件按 Java Properties 读取：值无需引号，不支持 export 或 shell 变量展开。
# 启动时在 IDEA 或命令行选择 dev；不要在此文件内设置运行环境。

# 本地服务与数据库连接。
SERVER_PORT=8080
# MinIO 容器需要回调宿主机；不要改为仅监听 127.0.0.1，否则无法发布上传文件。
SERVER_ADDRESS=0.0.0.0
# 下列无 TLS 参数仅用于回环地址上的本地开发 MySQL。
DB_URL=jdbc:mysql://127.0.0.1:13306/easy_community?sslMode=DISABLED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=ec_dev
DB_PASSWORD=replace-with-local-db-password

# Compose 中的 Redis 必须设置密码，与根目录配置的实际值一致。
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=replace-with-local-redis-password

# RabbitMQ：账号、密码及vhost必须与本机实际配置一致，示例不会自动创建资源。
# 此处为应用连接的AMQP端口，不是管理端口；宿主机映射不同时填写实际映射端口。
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ec_dev
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
RABBITMQ_VHOST=easy_community_dev
# 点赞是默认功能；首次部署和故障恢复时保持外部入口关闭，步骤见点赞运维手册。
LIKE_PER_MINUTE=60
# 第二应用实例必须使用不同的本机管理端口。
MANAGEMENT_PORT=18081

# Compose 自动初始化开发桶；浏览器上传响应适配留待后续 Vite 阶段。
MEDIA_STORAGE_PROVIDER=minio
MEDIA_STORAGE_ENDPOINT=http://127.0.0.1:19000
MEDIA_STORAGE_UPLOAD_ENDPOINT=http://127.0.0.1:19000
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_BUCKET=easy-community-dev
MEDIA_STORAGE_ACCESS_KEY=replace-with-minio-access-key
MEDIA_STORAGE_SECRET_KEY=replace-with-minio-secret-key
MEDIA_KEY_PREFIX=easy-community/dev
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:19000/easy-community-dev
MEDIA_WEBHOOK_TOKEN=replace-with-single-segment-webhook-secret
MEDIA_FRONTEND_ORIGIN=http://127.0.0.1:5173
MEDIA_UPLOADS_PER_MINUTE=30
